{
  "openrpc": "1.2.6",
  "info": {
    "title": "Agentic Server",
    "description": "JSON-RPC 2.0 interface between the Editor plugin client and the Agentic server.\n\nAll messages are wrapped in the envelope:\n```json\n{ \"jsonrpc\": \"2.0\", \"data\": { \"method\": \"<method>\", \"params\": { ... } } }\n```\n\n**CLIENT → SERVER** methods are sent by the Editor plugin.\n**SERVER → CLIENT** methods are responses or notifications pushed by the server.",
    "version": "0.1.0"
  },
  "methods": [
    {
      "name": "client/init",
      "summary": "Initialize the agent for the current workspace",
      "description": "Creates and spawns an agent using the specified AI provider in the given working directory. Must be called before any other client/* methods. Responds with success and the spawned agent ID.",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "requestId",
          "required": false,
          "summary": "Optional correlation ID for the request",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "provider",
          "required": true,
          "summary": "AI provider to use",
          "schema": {
            "anyOf": [
              {
                "type": "string",
                "const": "copilot"
              },
              {
                "type": "string",
                "const": "opencode"
              },
              {
                "type": "string",
                "const": "gemini"
              }
            ]
          }
        },
        {
          "name": "cwd",
          "required": true,
          "summary": "Absolute path to the workspace root",
          "schema": {
            "type": "string"
          }
        }
      ],
      "result": {
        "name": "InitResult",
        "schema": {
          "type": "object",
          "required": [
            "success",
            "agentId"
          ],
          "properties": {
            "success": {
              "type": "boolean"
            },
            "agentId": {
              "type": "string",
              "description": "Stable ID of the spawned agent"
            }
          }
        }
      },
      "examples": [
        {
          "name": "copilot init",
          "params": [
            {
              "name": "provider",
              "value": "copilot"
            },
            {
              "name": "cwd",
              "value": "/home/user/my-project"
            }
          ],
          "result": {
            "name": "result",
            "value": {
              "success": true,
              "agentId": "cm9abc123def456"
            }
          }
        }
      ]
    },
    {
      "name": "client/new_session",
      "summary": "Start a new session with the active agent",
      "description": "Begins a new session (conversation) with the currently active agent. Responds with success and the new session ID.",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "requestId",
          "required": false,
          "summary": "Optional correlation ID for the request",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "sessionName",
          "required": false,
          "summary": "Optional name for the new session",
          "schema": {
            "type": "string"
          }
        }
      ],
      "result": {
        "name": "NewSessionResult",
        "schema": {
          "type": "object",
          "required": [
            "success",
            "sessionId"
          ],
          "properties": {
            "success": {
              "type": "boolean"
            },
            "sessionId": {
              "type": "string",
              "description": "Stable ID of the new session"
            }
          }
        }
      },
      "examples": [
        {
          "name": "new session with name",
          "params": [
            {
              "name": "sessionName",
              "value": "Debugging session"
            }
          ],
          "result": {
            "name": "result",
            "value": {
              "success": true,
              "sessionId": "sess_abc123"
            }
          }
        },
        {
          "name": "new session without name",
          "params": [],
          "result": {
            "name": "result",
            "value": {
              "success": true,
              "sessionId": "sess_def456"
            }
          }
        }
      ]
    },
    {
      "name": "client/dispose",
      "summary": "Dispose the active agent and clean up resources",
      "description": "Terminates the spawned agent and releases any associated resources. Should be called when the session is complete or the user wants to reset. Responds with success.",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "requestId",
          "required": false,
          "summary": "Optional correlation ID for the request",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "reason",
          "required": false,
          "summary": "Optional reason for disposal",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "agentId",
          "required": false,
          "summary": "Optional ID of the specific agent to dispose",
          "schema": {
            "type": "string"
          }
        }
      ],
      "result": {
        "name": "DisposeResult",
        "schema": {
          "type": "object",
          "required": [
            "success"
          ],
          "properties": {
            "success": {
              "type": "boolean"
            }
          }
        }
      },
      "examples": [
        {
          "name": "dispose with reason",
          "params": [
            {
              "name": "reason",
              "value": "Session complete"
            }
          ],
          "result": {
            "name": "result",
            "value": {
              "success": true
            }
          }
        },
        {
          "name": "dispose without reason",
          "params": [],
          "result": {
            "name": "result",
            "value": {
              "success": true
            }
          }
        }
      ]
    },
    {
      "name": "client/ask",
      "summary": "Send a prompt to the active agent",
      "description": "Forwards a user prompt (with optional Editor context snippets) to the spawned agent. Requires a prior successful `client/init`.",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "requestId",
          "required": false,
          "summary": "Optional correlation ID for the request",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "prompt",
          "required": true,
          "summary": "The user's question or instruction",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "contexts",
          "required": false,
          "summary": "Optional Editor context objects to attach to the prompt",
          "schema": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type",
                "text"
              ],
              "properties": {
                "type": {
                  "anyOf": [
                    {
                      "type": "string",
                      "const": "selection"
                    },
                    {
                      "type": "string",
                      "const": "file"
                    },
                    {
                      "type": "string",
                      "const": "workspace"
                    },
                    {
                      "type": "string",
                      "const": "keymaps"
                    },
                    {
                      "type": "string",
                      "const": "diagnostics"
                    },
                    {
                      "type": "string",
                      "const": "image"
                    },
                    {
                      "type": "string",
                      "const": "audio"
                    },
                    {
                      "type": "string",
                      "const": "link"
                    }
                  ]
                },
                "text": {
                  "type": "string"
                },
                "metadata": {
                  "type": "object",
                  "properties": {
                    "mimetype": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "data": {
                      "type": "string"
                    },
                    "uri": {
                      "type": "string"
                    },
                    "size": {
                      "type": "number"
                    }
                  }
                },
                "annotations": {
                  "type": "object",
                  "properties": {
                    "audience": {
                      "type": "array",
                      "items": {
                        "anyOf": [
                          {
                            "type": "string",
                            "const": "user"
                          },
                          {
                            "type": "string",
                            "const": "assitant"
                          }
                        ]
                      }
                    },
                    "priority": {
                      "type": "number"
                    },
                    "lastModified": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "result": {
        "name": "AskResult",
        "schema": {
          "type": "object",
          "required": [
            "success"
          ],
          "properties": {
            "success": {
              "type": "boolean"
            }
          }
        }
      },
      "examples": [
        {
          "name": "plain prompt",
          "params": [
            {
              "name": "prompt",
              "value": "Explain what this function does"
            }
          ],
          "result": {
            "name": "result",
            "value": {
              "success": true
            }
          }
        },
        {
          "name": "prompt with file context",
          "params": [
            {
              "name": "prompt",
              "value": "Refactor this to use async/await"
            },
            {
              "name": "contexts",
              "value": [
                {
                  "type": "selection",
                  "content": "function fetchData(url) {\n  return fetch(url).then(r => r.json())\n}",
                  "metadata": {
                    "filePath": "src/api.ts",
                    "startLine": 12,
                    "endLine": 14
                  }
                }
              ]
            }
          ],
          "result": {
            "name": "result",
            "value": {
              "success": true
            }
          }
        }
      ]
    },
    {
      "name": "client/answer",
      "summary": "Reply to a question sent by the server via `agentic/question`",
      "description": "The server pauses and sends an `agentic/question` notification when the agent needs user input. Supply the answer here, referencing the same `questionId`.",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "requestId",
          "required": false,
          "summary": "Optional correlation ID for the request",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "questionId",
          "required": true,
          "summary": "ID of the question (from the `agentic/question` notification)",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "answer",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "result": {
        "name": "AnswerResult",
        "schema": {
          "type": "object",
          "required": [
            "success"
          ],
          "properties": {
            "success": {
              "type": "boolean"
            }
          }
        }
      },
      "examples": [
        {
          "name": "confirm a permission",
          "params": [
            {
              "name": "questionId",
              "value": "q_xyz789"
            },
            {
              "name": "answer",
              "value": "yes"
            }
          ],
          "result": {
            "name": "result",
            "value": {
              "success": true
            }
          }
        }
      ]
    },
    {
      "name": "client/terminal",
      "summary": "Send a terminal operation response back to the server",
      "description": "The server sends `agentic/terminal` notifications requesting terminal actions (create, get_output, wait_exit, kill, release). The client performs the action and replies with the result, matching `requestId`.",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "requestId",
          "required": true,
          "summary": "Matches the `requestId` from the originating `agentic/terminal` notification",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "error",
          "required": false,
          "summary": "Set if the terminal operation failed",
          "schema": {}
        },
        {
          "name": "response",
          "required": true,
          "summary": "Discriminated union keyed on `request`",
          "schema": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "request",
                  "params"
                ],
                "properties": {
                  "request": {
                    "type": "string",
                    "const": "create"
                  },
                  "params": {
                    "type": "object",
                    "required": [
                      "terminalId"
                    ],
                    "properties": {
                      "terminalId": {
                        "type": "string"
                      },
                      "jobId": {
                        "type": "number"
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "request",
                  "params"
                ],
                "properties": {
                  "request": {
                    "type": "string",
                    "const": "get_output"
                  },
                  "params": {
                    "type": "object",
                    "required": [
                      "stdout",
                      "stderr"
                    ],
                    "properties": {
                      "stdout": {
                        "type": "string"
                      },
                      "stderr": {
                        "type": "string"
                      },
                      "exitStatus": {
                        "type": "object",
                        "properties": {},
                        "additionalProperties": true
                      },
                      "truncated": {
                        "type": "boolean"
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "request",
                  "params"
                ],
                "properties": {
                  "request": {
                    "type": "string",
                    "const": "wait_exit"
                  },
                  "params": {
                    "type": "object",
                    "required": [
                      "exitStatus"
                    ],
                    "properties": {
                      "exitStatus": {
                        "type": "object",
                        "properties": {},
                        "additionalProperties": true
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "request",
                  "params"
                ],
                "properties": {
                  "request": {
                    "type": "string",
                    "const": "kill"
                  },
                  "params": {
                    "type": "object",
                    "required": [
                      "success"
                    ],
                    "properties": {
                      "success": {
                        "type": "boolean"
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "request",
                  "params"
                ],
                "properties": {
                  "request": {
                    "type": "string",
                    "const": "release"
                  },
                  "params": {
                    "type": "object",
                    "required": [
                      "success"
                    ],
                    "properties": {
                      "success": {
                        "type": "boolean"
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      ],
      "result": {
        "name": "NotificationResult",
        "schema": {
          "type": "null",
          "description": "Fire-and-forget — no response"
        }
      },
      "examples": [
        {
          "name": "create terminal response",
          "params": [
            {
              "name": "requestId",
              "value": "req_001"
            },
            {
              "name": "response",
              "value": {
                "request": "create",
                "params": {
                  "terminalId": "term_abc",
                  "jobId": 42
                }
              }
            }
          ],
          "result": {
            "name": "result",
            "value": null
          }
        },
        {
          "name": "get_output response",
          "params": [
            {
              "name": "requestId",
              "value": "req_002"
            },
            {
              "name": "response",
              "value": {
                "request": "get_output",
                "params": {
                  "stdout": "Hello, world!\n",
                  "stderr": "",
                  "truncated": false
                }
              }
            }
          ],
          "result": {
            "name": "result",
            "value": null
          }
        }
      ]
    },
    {
      "name": "agentic/respond",
      "summary": "[Server → Client] Result or error for a prior client/* call",
      "description": "Sent by the server after processing any `client/*` method. `method` echoes the original client method, `id` correlates to the `requestId` supplied in the params (if any). Exactly one of `result` or `error` will be present.",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "method",
          "required": true,
          "summary": "The client method this response belongs to",
          "schema": {
            "anyOf": [
              {
                "type": "string",
                "const": "client/init"
              },
              {
                "type": "string",
                "const": "client/dispose"
              },
              {
                "type": "string",
                "const": "client/ask"
              },
              {
                "type": "string",
                "const": "client/answer"
              },
              {
                "type": "string",
                "const": "client/terminal"
              },
              {
                "type": "string",
                "const": "client/new_session"
              },
              {
                "type": "string",
                "const": "client/load_session"
              },
              {
                "type": "string",
                "const": "client/rename_session"
              },
              {
                "type": "string",
                "const": "client/delete_session"
              },
              {
                "type": "string",
                "const": "client/archive_session"
              },
              {
                "type": "string",
                "const": "client/fork_session"
              },
              {
                "type": "string",
                "const": "client/resume_session"
              },
              {
                "type": "string",
                "const": "client/switch_session_mode"
              },
              {
                "type": "string",
                "const": "client/switch_model"
              },
              {
                "type": "string",
                "const": "client/list_sessions"
              }
            ]
          }
        },
        {
          "name": "id",
          "required": false,
          "summary": "Correlates to the requestId sent in the client params",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "error",
          "required": false,
          "summary": "Set when the server encountered an error",
          "schema": {}
        },
        {
          "name": "result",
          "required": false,
          "summary": "Set on success — shape depends on the method",
          "schema": {}
        }
      ],
      "result": {
        "name": "NotificationResult",
        "schema": {
          "type": "null",
          "description": "Notification — no response expected"
        }
      },
      "examples": [
        {
          "name": "successful init response",
          "params": [
            {
              "name": "method",
              "value": "client/init"
            },
            {
              "name": "id",
              "value": "req_001"
            },
            {
              "name": "type",
              "value": "response"
            },
            {
              "name": "result",
              "value": {
                "success": true,
                "agentId": "cm9abc123def456"
              }
            }
          ],
          "result": {
            "name": "result",
            "value": null
          }
        },
        {
          "name": "error response",
          "params": [
            {
              "name": "method",
              "value": "client/ask"
            },
            {
              "name": "id",
              "value": "req_002"
            },
            {
              "name": "type",
              "value": "response"
            },
            {
              "name": "error",
              "value": {
                "message": "Agent not initialised"
              }
            }
          ],
          "result": {
            "name": "result",
            "value": null
          }
        }
      ]
    },
    {
      "name": "agentic/log",
      "summary": "[Server → Client] Log message notification",
      "description": "Pushed by the server to stream log output to the Editor plugin. Not a request — no response expected.",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "level",
          "schema": {
            "anyOf": [
              {
                "type": "string",
                "const": "info"
              },
              {
                "type": "string",
                "const": "warn"
              },
              {
                "type": "string",
                "const": "error"
              }
            ]
          },
          "required": true
        },
        {
          "name": "message",
          "schema": {
            "type": "string"
          },
          "required": true
        }
      ],
      "result": {
        "name": "NotificationResult",
        "schema": {
          "type": "null",
          "description": "Notification — no response expected"
        }
      },
      "examples": [
        {
          "name": "info log",
          "params": [
            {
              "name": "level",
              "value": "info"
            },
            {
              "name": "message",
              "value": "Agent spawned successfully"
            },
            {
              "name": "type",
              "value": "notification"
            }
          ],
          "result": {
            "name": "result",
            "value": null
          }
        }
      ]
    },
    {
      "name": "agentic/terminal",
      "summary": "[Server → Client] Request a terminal operation in the Editor",
      "description": "The server needs to execute a shell command. Sends this notification requesting the Editor plugin to manage the terminal lifecycle. The client must respond with `client/terminal` matching the `requestId`.",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "request",
          "schema": {
            "type": "string",
            "enum": [
              "create",
              "get_output",
              "wait_exit",
              "kill",
              "release"
            ]
          },
          "required": true
        },
        {
          "name": "params",
          "schema": {
            "oneOf": [
              {
                "title": "create",
                "type": "object",
                "required": [
                  "requestId",
                  "terminalId",
                  "command"
                ],
                "properties": {
                  "requestId": {
                    "type": "string"
                  },
                  "terminalId": {
                    "type": "string"
                  },
                  "command": {
                    "type": "string"
                  },
                  "cwd": {
                    "type": "string"
                  },
                  "env": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {},
                      "additionalProperties": true
                    }
                  },
                  "outputByteLimit": {
                    "type": "number"
                  }
                }
              },
              {
                "title": "get_output",
                "type": "object",
                "required": [
                  "requestId",
                  "terminalId"
                ],
                "properties": {
                  "requestId": {
                    "type": "string"
                  },
                  "terminalId": {
                    "type": "string"
                  }
                }
              },
              {
                "title": "wait_exit",
                "type": "object",
                "required": [
                  "requestId",
                  "terminalId"
                ],
                "properties": {
                  "requestId": {
                    "type": "string"
                  },
                  "terminalId": {
                    "type": "string"
                  }
                }
              },
              {
                "title": "kill",
                "type": "object",
                "required": [
                  "requestId",
                  "terminalId",
                  "signal"
                ],
                "properties": {
                  "requestId": {
                    "type": "string"
                  },
                  "terminalId": {
                    "type": "string"
                  },
                  "signal": {
                    "type": "string"
                  }
                }
              },
              {
                "title": "release",
                "type": "object",
                "required": [
                  "requestId",
                  "terminalId"
                ],
                "properties": {
                  "requestId": {
                    "type": "string"
                  },
                  "terminalId": {
                    "type": "string"
                  }
                }
              }
            ]
          },
          "required": true
        }
      ],
      "result": {
        "name": "NotificationResult",
        "schema": {
          "type": "null",
          "description": "Notification — client responds via client/terminal"
        }
      },
      "examples": [
        {
          "name": "create terminal",
          "params": [
            {
              "name": "request",
              "value": "create"
            },
            {
              "name": "params",
              "value": {
                "requestId": "req_001",
                "terminalId": "term_abc",
                "command": "npm test",
                "cwd": "/home/user/my-project"
              }
            },
            {
              "name": "type",
              "value": "notification"
            }
          ],
          "result": {
            "name": "result",
            "value": null
          }
        },
        {
          "name": "kill terminal",
