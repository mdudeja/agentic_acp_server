{
  "name": "server",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun --env-file=.env run index.ts",
    "start:http": "bun --env-file=.env.http --watch run index.ts",
    "lint": "bun tsc --noEmit",
    "build": "bun run gen:openrpc && bun build --target=bun index.ts --minify",
    "test": "bun --env-file=.env.test run test",
    "gen:openrpc": "bun scripts/gen-openrpc.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.14.1",
    "@paralleldrive/cuid2": "^3.3.0",
    "drizzle-orm": "^1.0.0-beta.16-ea816b6",
    "prettier": "^3.8.1",
    "temporal-polyfill": "^0.3.0",
    "typebox": "^1.1.5"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "drizzle-kit": "^1.0.0-beta.15-859cf75"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  }
}
