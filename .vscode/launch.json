    "version": "0.2.0",
    "configurations": [
        {
            "type": "bun",
            "internalConsoleOptions": "openOnSessionStart",
            "request": "launch",
            "name": "Debug Start",
            "runtime": "bun",
            "runtimeArgs": [
                "run",
                "start",
            ],
            "cwd": "${workspaceFolder}",
            "stopOnEntry": false,
            "watchMode": false
        },
        {
            "type": "bun",
            "internalConsoleOptions": "openOnSessionStart",
            "request": "launch",
            "name": "Debug Tests",
            "runtime": "bun",
            "runtimeArgs": [
                "run",
                "test"
            ],
            "cwd": "${workspaceFolder}",
            "stopOnEntry": false,
            "watchMode": false
        },
        {
            "type": "bun",
            "name": "Attach to Tests",
            "request": "attach",
            "url": " ws://localhost:6499/93662ea0-2253-4548-a522-2b090967f689",
        }
    ]
}